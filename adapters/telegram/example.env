# Telegram adapter instance. chmod 600.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to talk to the agent.
ALLOWED_USER_IDS=
# Optional one-time pairing: a user who sends "/start <PAIR_CODE>" is added to the allow list.
PAIR_CODE=
INBOX=inbox-NAME
OUTBOX_LOG=/home/USER/mailbox/outbox-NAME.log
